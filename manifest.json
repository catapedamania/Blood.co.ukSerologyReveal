{
  "manifest_version": 3,
  "name": "Blood.co.uk Serology Rh Phenotype Display",
  "version": "1.3",
  "description": "Capture serology Rh phenotype and display it on the blood.co.uk account screen.",
  "permissions": ["storage", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["https://my.blood.co.uk/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://my.blood.co.uk/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_inject.js"],
      "matches": ["https://my.blood.co.uk/*"]
    }
  ]
}
